rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /sessions/{sessionId} {
      allow read: if false;
      allow write: if false;

      match /players/{playerId} {
        allow read: if false;
        allow write: if false;
      }

      match /events/{eventId} {
        allow read: if false;
        allow write: if false;
      }
    }

    match /venues/{venueId} {
      allow read: if false;
      allow write: if false;
    }
  }
}