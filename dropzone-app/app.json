{
  "expo": {
    "name": "DropZone",
    "slug": "dropzone-app",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0a0a1a",
    "ios": {
      "supportsTablet": false,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "DropZone needs your location to track your position in the game zone.",
        "NSCameraUsageDescription": "DropZone uses the camera for the AR viewfinder during gameplay."
      }
    },
    "android": {
      "package": "com.dropzone.battleroyale",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#0a0a1a",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-screen-orientation",
      "expo-audio",
      [
        "expo-camera",
        {
          "cameraPermission": "DropZone uses the camera to scan battle tags during gameplay."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "f44350fe-0c2f-488b-8e61-c7ad345f20b2"
      }
    }
  }
}
